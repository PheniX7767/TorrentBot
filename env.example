# Telegram
BOT_TOKEN=123456:ABC-DEF
# Who can use the bot — either form works:
# ALLOWED_USER_IDS=123456789,987654321
# ALLOWED_USER_ID=123456789,987654321
ALLOWED_USER_IDS=123456789,987654321
# Who can view /stats (subset of allowlist). Empty = nobody.
ADMIN_USER_IDS=123456789
# Friendly names for /stats: id:Name pairs
CLIENT_NAMES=123456789:Admin,987654321:Friend
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Must be True for files >50MB (enables --local on telegram-bot-api)
TELEGRAM_LOCAL=True

# Local Bot API (inside compose — override only if needed)
BOT_API_BASE_URL=http://telegram-bot-api:8081

# qBittorrent (inside compose)
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
# linuxserver/qbittorrent prints a temporary password in logs on first start;
# set it here after you change/copy it from the container logs.
QBITTORRENT_PASSWORD=changeme

# Paths / host
DATA_DIR=/var/lib/torrent-bot
DOWNLOADS_DIR=/downloads
# Persistent usage counters (host: $DATA_DIR/bot-data/usage_stats.json)
USAGE_STATS_PATH=/data/usage_stats.json
PUID=1000
PGID=1000
TZ=Europe/Moscow

# Optional Netscape cookies for Instagram/TikTok/etc (host: $DATA_DIR/cookies/cookies.txt)
YTDLP_COOKIES_FILE=/cookies/cookies.txt

# Limits
MAX_SELECTED_BYTES=21474836480
MIN_FREE_BYTES=2147483648
ZIP_PART_BYTES=1992294400
STALE_JOB_HOURS=24
PROGRESS_EDIT_SECONDS=20
